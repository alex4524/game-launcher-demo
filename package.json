{
  "name": "game-launcher-demo",
  "productName": "Game Launcher Demo",
  "version": "1.0.0",
  "description": "A desktop game launcher demo: chunked download, resume, SHA-256 verification, multi-CDN failover, delta update, repair, gray release.",
  "main": "dist/main.cjs",
  "author": "Alex <alex4524@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "build:server": "node scripts/build.mjs server",
    "server": "node scripts/build.mjs server && node dist/server.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "33.4.11",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
